# Copie para .env e ajuste com as credenciais reais antes de subir o container.
#
# ATENCAO (Docker Compose): se a senha contiver "$", escreva "$$" no lugar
# (ex.: senha "Abc$xyz" -> "Abc$$xyz"), senao o Compose interpreta como
# variavel de shell e trunca a senha silenciosamente.

# Se true, le a origem via SQL (SRC_SQL_CONNECTION); se false, usa CSV (INPUT_CSV).
USE_SQL_ORIGIN=true

# String de conexão SQL Server de ORIGEM (obrigatória se USE_SQL_ORIGIN=true)
SRC_SQL_CONNECTION=sqlserver://usuario:senha@host:1433?database=NomeDoBanco

# String de conexão SQL Server de DESTINO (sempre obrigatória)
DEST_SQL_CONNECTION=sqlserver://usuario:senha@host:1433?database=NomeDoBanco

# Usado apenas quando USE_SQL_ORIGIN=false
INPUT_CSV=./resultado_query.csv
CSV_SEP=;

TBL_DETALHADO=dbo.BH_DetalhadoPosAbatimento
TBL_RESUMO=dbo.BH_ResumoMensalSaldo

CLEAR_DEST=true
UPSERT_RESUMO=true

HTTP_PORT=:8093
